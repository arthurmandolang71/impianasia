{
  "name": "impianasia",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page PT Impian Asia Utama — Cloudflare Workers static assets",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --watch",
    "build": "npm run build:css",
    "dev": "npm run watch:css & wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4"
  }
}
